<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A2744">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <!-- Guardian Mom's rejection message -->
        <TextView
            android:id="@+id/tv_reflect_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textColor="#7788AA"
            android:textSize="15sp"
            android:textStyle="italic" />

        <!-- Intervention card — content set programmatically from InterventionData -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_intervention_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="28dp">

            <!-- Category label, e.g. "💭  REFLECT" -->
            <TextView
                android:id="@+id/tv_intervention_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textAllCaps="true"
                android:textColor="#A78BFA"
                android:textSize="11sp"
                android:letterSpacing="0.12" />

            <!-- Main content: question / video title / nudge instruction -->
            <TextView
                android:id="@+id/tv_intervention_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.45"
                android:textColor="#EEEEFF"
                android:textSize="17sp" />

            <!-- Only visible for YouTube interventions -->
            <Button
                android:id="@+id/btn_intervention_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Skip Instagram entirely -->
        <Button
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingHorizontal="32dp"
            android:text="I'll skip Instagram" />

        <!-- Escape hatch — grants 5 min anyway -->
        <TextView
            android:id="@+id/tv_open_anyway"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="Open anyway (5 min)"
            android:textColor="#78909C"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>